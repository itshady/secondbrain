#!/usr/bin/env bash
# Second Brain CLI Supervisor & Utility Belt (`bin/secondbrain`)
# Commands:
#   secondbrain status | ps
#   secondbrain prune
#   secondbrain report --task <id> --status <status> --summary "..." [--project <proj>] [--parent <bb_thread_id>]
#   secondbrain search "<query>"
#   secondbrain compact
#   secondbrain invariants
#   secondbrain privacy-check
#   secondbrain secrets-sync [repo_path]
#   secondbrain judge-approve [--note "..."]
#   secondbrain upgrade
#   secondbrain publish [commit_message]
set -euo pipefail

SECONDBRAIN_HOME="${SECONDBRAIN_HOME:-$HOME/.secondbrain}"
SECONDBRAIN_VAULT="${SECONDBRAIN_VAULT:-$HOME/.secondbrain-vault}"
PYTHON_BIN="$SECONDBRAIN_HOME/.venv/bin/python"
if [[ ! -x "$PYTHON_BIN" ]]; then
  PYTHON_BIN="$(command -v python3)"
fi

CMD="${1:-status}"
shift || true

case "$CMD" in
  status|ps)
    PROJECT="${1:-}"
    "$PYTHON_BIN" "$SECONDBRAIN_HOME/mcp-server/server.py" --rpc roster_status --params "$(
      "$PYTHON_BIN" -c 'import json, sys; print(json.dumps({"project": sys.argv[1] or None}))' "$PROJECT"
    )"
    ;;

  search)
    QUERY="${1:-}"
    if [[ -z "$QUERY" ]]; then
      echo "Usage: secondbrain search \"<query>\"" >&2
      exit 1
    fi
    "$PYTHON_BIN" "$SECONDBRAIN_HOME/mcp-server/server.py" --rpc memory_search --params "$(
      "$PYTHON_BIN" -c 'import json, sys; print(json.dumps({"query": sys.argv[1], "top_k": 3}))' "$QUERY"
    )"
    ;;

  compact)
    "$PYTHON_BIN" "$SECONDBRAIN_HOME/mcp-server/server.py" --rpc memory_compact --params '{"threshold": 0.85}'
    ;;

  invariants)
    DOMAIN="${1:-general}"
    "$PYTHON_BIN" "$SECONDBRAIN_HOME/mcp-server/server.py" --rpc get_invariants --params "$(
      "$PYTHON_BIN" -c 'import json, sys; print(json.dumps({"domain": sys.argv[1]}))' "$DOMAIN"
    )"
    ;;

  report)
    TASK_ID=""
    PROJECT="default"
    STATUS="ok"
    SUMMARY=""
    PARENT_ID="${BB_PARENT_THREAD_ID:-}"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --task) TASK_ID="$2"; shift 2 ;;
        --project) PROJECT="$2"; shift 2 ;;
        --status) STATUS="$2"; shift 2 ;;
        --summary) SUMMARY="$2"; shift 2 ;;
        --parent) PARENT_ID="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    "$PYTHON_BIN" "$SECONDBRAIN_HOME/mcp-server/server.py" --rpc roster_report --params "$(
      "$PYTHON_BIN" -c '
import json, sys
print(json.dumps({
    "task_id": sys.argv[1],
    "project": sys.argv[2],
    "status": sys.argv[3],
    "summary": sys.argv[4],
}))
' "$TASK_ID" "$PROJECT" "$STATUS" "$SUMMARY"
    )" >/dev/null

    # If inside BB with a parent thread ID, wake the parent thread natively
    if [[ -n "$PARENT_ID" ]] && command -v bb >/dev/null 2>&1; then
      bb thread tell "$PARENT_ID" "[$STATUS] Task $TASK_ID ($PROJECT): $SUMMARY" >/dev/null 2>&1 || true
    fi
    echo "{\"reported\": true, \"task_id\": \"$TASK_ID\", \"status\": \"$STATUS\"}"
    ;;

  prune)
    # Ancestor-safe dead worktree cleanup across all registered projects in Private Vault
    "$PYTHON_BIN" - "$SECONDBRAIN_HOME" "$SECONDBRAIN_VAULT" <<'PYEOF'
import json, os, subprocess, sys, yaml
from pathlib import Path

engine_dir = Path(sys.argv[1])
vault_dir = Path(sys.argv[2])
projects_dir = vault_dir / "projects"

pruned = []
preserved_unmerged = []

if projects_dir.exists():
    for md in sorted(projects_dir.glob("*.md")):
        raw = md.read_text(encoding="utf-8")
        fm = {}
        if raw.startswith("---\n"):
            parts = raw.split("\n---\n", 1)
            if len(parts) == 2:
                fm = yaml.safe_load(parts[0][4:]) or {}
        repo_path = Path(os.path.expanduser(str(fm.get("repo_path", ""))))
        base_branch = str(fm.get("default_branch", "main"))
        wt_root = repo_path / ".worktrees"
        if not wt_root.exists():
            continue
        for wt_dir in sorted(wt_root.iterdir()):
            if not wt_dir.is_dir():
                continue
            # Check if worktree HEAD is an ancestor of base_branch and has no dirty files
            dirty = subprocess.run(["git", "-C", str(wt_dir), "status", "--porcelain"], capture_output=True, text=True)
            is_anc = subprocess.run(
                ["git", "-C", str(repo_path), "merge-base", "--is-ancestor", "HEAD", base_branch],
                cwd=str(wt_dir),
                capture_output=True,
            )
            if dirty.returncode == 0 and not dirty.stdout.strip() and is_anc.returncode == 0:
                for dep in ("node_modules", ".venv"):
                    dep_p = wt_dir / dep
                    if dep_p.is_symlink():
                        dep_p.unlink()
                subprocess.run(["git", "-C", str(repo_path), "worktree", "remove", "--force", str(wt_dir)], capture_output=True)
                subprocess.run(["git", "-C", str(repo_path), "branch", "-d", f"task/{wt_dir.name}"], capture_output=True)
                pruned.append(str(wt_dir))
            else:
                preserved_unmerged.append(str(wt_dir))

print(json.dumps({"pruned_worktrees": pruned, "preserved_unmerged_worktrees": preserved_unmerged}, indent=2))
PYEOF
    ;;

  secrets-sync)
    TARGET_REPO="${1:-}"
    "$PYTHON_BIN" - "$SECONDBRAIN_HOME" "$SECONDBRAIN_VAULT" "$TARGET_REPO" <<'PYEOF'
import os, sys, yaml
from pathlib import Path

engine_dir = Path(sys.argv[1]).resolve()
vault_dir = Path(sys.argv[2]).resolve()
target_arg = sys.argv[3].strip()

secrets_dir = Path.home() / ".secrets"
secrets_dir.mkdir(mode=0o700, exist_ok=True)
global_env = secrets_dir / "global.env"
if not global_env.exists():
    global_env.touch(mode=0o600)

def parse_env_lines(path: Path) -> dict[str, str]:
    if not path.is_file():
        return {}
    res = {}
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            k, v = line.split("=", 1)
            res[k.strip()] = v.strip()
    return res

def sync_one_repo(repo_path: Path, slug: str):
    if slug == "secondbrain" or repo_path == engine_dir:
        # Never write a .env into Public Engine
        return
    # Order of precedence: local .env preserves custom keys, overridden by global.env, overridden by <slug>.env
    merged = {}
    dest_env = repo_path / ".env"
    if dest_env.is_file() and not dest_env.is_symlink():
        merged.update(parse_env_lines(dest_env))
    merged.update(parse_env_lines(global_env))
    proj_env = secrets_dir / f"{slug}.env"
    if proj_env.is_file():
        merged.update(parse_env_lines(proj_env))

    if merged or proj_env.exists() or global_env.exists():
        content = "\n".join(f"{k}={v}" for k, v in sorted(merged.items())) + "\n"
        if not dest_env.is_symlink():
            dest_env.write_text(content, encoding="utf-8")
            dest_env.chmod(0o600)

    # Protect .env in git
    git_dir = repo_path / ".git"
    if git_dir.is_dir():
        exclude_file = git_dir / "info" / "exclude"
        exclude_file.parent.mkdir(parents=True, exist_ok=True)
        current = exclude_file.read_text(encoding="utf-8") if exclude_file.exists() else ""
        if not any(line.strip() == ".env" for line in current.splitlines()):
            with exclude_file.open("a", encoding="utf-8") as f:
                f.write("\n.env\n")

    print(f"Synced secrets for '{slug}' -> {dest_env} ({len(merged)} variables)")

if target_arg:
    p = Path(os.path.expanduser(target_arg)).resolve()
    # Find matching project slug from charters or fallback to folder name
    slug = p.name.lstrip(".")
    projects_dir = vault_dir / "projects"
    if projects_dir.is_dir():
        for md in projects_dir.glob("*.md"):
            raw = md.read_text(encoding="utf-8", errors="ignore")
            if raw.startswith("---\n"):
                parts = raw.split("\n---\n", 1)
                if len(parts) == 2:
                    try:
                        fm = yaml.safe_load(parts[0][4:]) or {}
                        rp = Path(os.path.expanduser(str(fm.get("repo_path", "")))).resolve()
                        if rp == p and fm.get("slug"):
                            slug = str(fm["slug"])
                            break
                    except Exception:
                        pass
    sync_one_repo(p, slug)
else:
    # Sync all registered projects
    synced_any = False
    projects_dir = vault_dir / "projects"
    if projects_dir.is_dir():
        for md in sorted(projects_dir.glob("*.md")):
            raw = md.read_text(encoding="utf-8", errors="ignore")
            if raw.startswith("---\n"):
                parts = raw.split("\n---\n", 1)
                if len(parts) == 2:
                    try:
                        fm = yaml.safe_load(parts[0][4:]) or {}
                        rp_str = fm.get("repo_path")
                        slug = str(fm.get("slug") or md.stem)
                        if rp_str:
                            rp = Path(os.path.expanduser(str(rp_str))).resolve()
                            if rp.is_dir():
                                sync_one_repo(rp, slug)
                                synced_any = True
                    except Exception:
                        pass
    if not synced_any:
        print("No registered projects found in vault to sync.")
PYEOF
    ;;

  privacy-check)
    # Vault-Aware Privacy Scanner: ensures zero personal paths, secret tokens, or Private Vault project names leak into Public Engine
    "$PYTHON_BIN" - "$SECONDBRAIN_HOME" "$SECONDBRAIN_VAULT" <<'PYEOF'
import os, re, subprocess, sys, yaml
from pathlib import Path

engine_dir = Path(sys.argv[1]).resolve()
vault_dir = Path(sys.argv[2]).resolve()
username = os.environ.get("USER") or Path.home().name

forbidden_paths = {f"/Users/{username}"}
forbidden_project_slugs = set()
# Collect private project slugs/names from Private Vault (excluding generic 'secondbrain' or 'example-project')
projects_dir = vault_dir / "projects"
if projects_dir.exists():
    for md in projects_dir.glob("*.md"):
        if md.stem not in ("secondbrain", "example-project", "example"):
            forbidden_project_slugs.add(md.stem)

secret_regex = re.compile(r"(?:-----BEGIN [A-Z ]*PRIVATE KEY-----|\b(?:sk-[A-Za-z0-9]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16})\b)")
data_uri_regex = re.compile(r"data:[^;]+;base64,[A-Za-z0-9+/=]+")

tracked = subprocess.run(
    ["git", "-C", str(engine_dir), "ls-files"],
    capture_output=True,
    text=True,
    check=True,
).stdout.splitlines()

violations = []
for rel in tracked:
    fp = engine_dir / rel
    if not fp.is_file():
        continue
    try:
        text = fp.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        continue
    # Strip embedded base64 font/image blobs before scanning for project identifiers
    scannable_text = data_uri_regex.sub("", text)
    for term in forbidden_paths:
        if term and term in scannable_text:
            violations.append(f"{rel}: contains private path '{term}'")
    for slug in forbidden_project_slugs:
        if slug and re.search(rf"(?<![A-Za-z0-9]){re.escape(slug)}(?![A-Za-z0-9])", scannable_text, re.IGNORECASE):
            violations.append(f"{rel}: contains private project identifier '{slug}'")
    if secret_regex.search(scannable_text):
        violations.append(f"{rel}: matches secret token pattern")

# Also scan unpushed commit messages and diffs in origin/main..HEAD if origin/main exists
has_origin = subprocess.run(
    ["git", "-C", str(engine_dir), "rev-parse", "--verify", "origin/main"],
    capture_output=True,
).returncode == 0
if has_origin:
    unpushed_log = subprocess.run(
        ["git", "-C", str(engine_dir), "log", "origin/main..HEAD", "-p"],
        capture_output=True,
        text=True,
    ).stdout
    scannable_log = data_uri_regex.sub("", unpushed_log)
    for term in forbidden_paths:
        if term and term in scannable_log:
            violations.append(f"git log (origin/main..HEAD): contains private path '{term}'")
    for slug in forbidden_project_slugs:
        if slug and re.search(rf"(?<![A-Za-z0-9]){re.escape(slug)}(?![A-Za-z0-9])", scannable_log, re.IGNORECASE):
            violations.append(f"git log (origin/main..HEAD): contains private project identifier '{slug}'")
    if secret_regex.search(scannable_log):
        violations.append("git log (origin/main..HEAD): matches secret token pattern")

if violations:
    print("PRIVACY CHECK FAILED — Blocked from Public Engine:", file=sys.stderr)
    for v in violations:
        print(f"  - {v}", file=sys.stderr)
    sys.exit(1)

print("Privacy check passed: 0 personal paths, 0 private vault project names, 0 secrets found in Public Engine.")
PYEOF
    ;;

  judge-approve)
    NOTE=""
    FORCE="false"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --note) NOTE="$2"; shift 2 ;;
        --force) FORCE="true"; shift 1 ;;
        *) shift ;;
      esac
    done

    "$SECONDBRAIN_HOME/bin/secondbrain" privacy-check

    HEAD_SHA="$(git -C "$SECONDBRAIN_HOME" rev-parse HEAD)"
    STAMP_FILE="$SECONDBRAIN_HOME/.git/publish_judge_stamp.json"

    # Stage 2: Independent Sub-Agent Audit
    "$PYTHON_BIN" - "$SECONDBRAIN_HOME" "$HEAD_SHA" "$NOTE" "$FORCE" "$STAMP_FILE" <<'PYEOF'
import json, os, re, shutil, subprocess, sys, time
from pathlib import Path

engine_dir = Path(sys.argv[1]).resolve()
head_sha = sys.argv[2]
user_note = sys.argv[3]
force = sys.argv[4] == "true"
stamp_path = Path(sys.argv[5])

rubric_path = engine_dir / ".bb" / "skills" / "publish-judge" / "SKILL.md"
rubric_text = rubric_path.read_text(encoding="utf-8") if rubric_path.exists() else "Auditing against 5-point Public Release Rubric: zero personal paths, zero private project names, zero secrets, 100% universal OS scope, clean history."

diff_res = subprocess.run(
    ["git", "-C", str(engine_dir), "diff", "origin/main..HEAD"],
    capture_output=True,
    text=True,
)
diff_text = diff_res.stdout
if not diff_text.strip():
    diff_text = subprocess.run(
        ["git", "-C", str(engine_dir), "show", "--stat", head_sha],
        capture_output=True,
        text=True,
    ).stdout

judge_prompt = f"""You are the Second Brain Public Release Privacy Judge.
Your sole job is to audit this git diff against the 5-point Public Release Rubric before it is pushed to the public repository.

[5-POINT PUBLIC RELEASE RUBRIC]
{rubric_text}

[GIT DIFF TO AUDIT]
{diff_text}

Respond ONLY with a single valid JSON object in this exact schema, with no markdown fences, no code blocks, and no extra commentary:
{{"verdict": "PASS" | "BLOCK", "reason": "<one sentence concise justification>"}}
"""

judge_res_json = None
judge_harness = None

# 1. Try agy (lightweight Gemini 3.8 Flash, low effort)
if shutil.which("agy"):
    try:
        proc = subprocess.run(
            ["agy", "-p", judge_prompt, "--model", "gemini-3.8-flash", "--effort", "low"],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            raw = proc.stdout.strip()
            # Extract JSON substring if wrapped in anything
            m = re.search(r"\{.*\}", raw, re.DOTALL)
            if m:
                data = json.loads(m.group(0))
                if data.get("verdict") in ("PASS", "BLOCK"):
                    judge_res_json = data
                    judge_harness = "agy (gemini-3.8-flash:low)"
    except Exception:
        pass

# 2. Fallback to claude / codex if agy not available
if not judge_res_json and shutil.which("claude"):
    try:
        proc = subprocess.run(
            ["claude", "-p", judge_prompt, "--model", "claude-haiku-4-5-20251001", "--bare"],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            m = re.search(r"\{.*\}", proc.stdout.strip(), re.DOTALL)
            if m:
                data = json.loads(m.group(0))
                if data.get("verdict") in ("PASS", "BLOCK"):
                    judge_res_json = data
                    judge_harness = "claude (haiku)"
    except Exception:
        pass

if not judge_res_json and shutil.which("codex"):
    try:
        proc = subprocess.run(
            ["codex", "exec", judge_prompt, "--model", "gpt-5.6-luna"],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            m = re.search(r"\{.*\}", proc.stdout.strip(), re.DOTALL)
            if m:
                data = json.loads(m.group(0))
                if data.get("verdict") in ("PASS", "BLOCK"):
                    judge_res_json = data
                    judge_harness = "codex (luna)"
    except Exception:
        pass

if not judge_res_json:
    if force and user_note and len(user_note) >= 20:
        judge_res_json = {"verdict": "PASS", "reason": f"Manual override: {user_note}"}
        judge_harness = "manual_override"
    else:
        print("STAGE 2 JUDGE ERROR: Could not execute stateless judge agent (no working agy/claude/codex CLI available).", file=sys.stderr)
        print("Pass --force with a verified --note (>=20 chars) if you need to approve manually.", file=sys.stderr)
        sys.exit(1)

verdict = judge_res_json.get("verdict")
reason = judge_res_json.get("reason", "No reason provided")

if verdict != "PASS":
    print(f"STAGE 2 JUDGE REJECTED PUSH ({judge_harness}):\n  -> {reason}", file=sys.stderr)
    sys.exit(1)

stamp_path.write_text(json.dumps({
    "head_sha": head_sha,
    "verdict": "PASS",
    "judge_harness": judge_harness,
    "reason": reason,
    "user_note": user_note,
    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
}, indent=2) + "\n", encoding="utf-8")

print(f"Stage 2 Public Release Judge PASSED via {judge_harness} for HEAD {head_sha[:7]}: {reason}")
PYEOF
    ;;

  judge-verify)
    "$SECONDBRAIN_HOME/bin/secondbrain" privacy-check
    # If there are no unpushed commits compared to origin/main, pass immediately
    if git -C "$SECONDBRAIN_HOME" rev-parse --verify origin/main >/dev/null 2>&1; then
      UNPUSHED="$(git -C "$SECONDBRAIN_HOME" rev-list origin/main..HEAD --count 2>/dev/null || echo 0)"
      if [[ "$UNPUSHED" -eq 0 ]]; then
        exit 0
      fi
    fi
    HEAD_SHA="$(git -C "$SECONDBRAIN_HOME" rev-parse HEAD)"
    STAMP_FILE="$SECONDBRAIN_HOME/.git/publish_judge_stamp.json"
    "$PYTHON_BIN" - "$STAMP_FILE" "$HEAD_SHA" <<'PYEOF'
import json, sys
from pathlib import Path
stamp_path, head_sha = Path(sys.argv[1]), sys.argv[2]
if not stamp_path.exists():
    print(
        f"STAGE 2 JUDGE GATE BLOCKED PUSH: No judge stamp found for HEAD {head_sha[:7]}.\n"
        "  -> Read .bb/skills/publish-judge/SKILL.md, inspect 'git -C ~/.secondbrain diff origin/main..HEAD',\n"
        "  -> Then run: secondbrain judge-approve --note \"<5-point rubric audit summary>\"",
        file=sys.stderr,
    )
    sys.exit(1)
data = json.loads(stamp_path.read_text(encoding="utf-8"))
if data.get("head_sha") != head_sha or data.get("verdict") != "PASS":
    print(
        f"STAGE 2 JUDGE GATE BLOCKED PUSH: Stamp SHA ({str(data.get('head_sha'))[:7]}) does not match current HEAD ({head_sha[:7]}).\n"
        "  -> Re-audit 'git -C ~/.secondbrain diff origin/main..HEAD' per .bb/skills/publish-judge/SKILL.md,\n"
        "  -> Then run: secondbrain judge-approve --note \"<5-point rubric audit summary>\"",
        file=sys.stderr,
    )
    sys.exit(1)
print(f"Stage 2 Public Release Judge verified for HEAD {head_sha[:7]}: {data.get('note')}")
PYEOF
    ;;

  upgrade)
    echo "==> Unlocking Public Engine for upgrade..."
    chmod -R u+w "$SECONDBRAIN_HOME" 2>/dev/null || true
    if git -C "$SECONDBRAIN_HOME" remote get-url origin >/dev/null 2>&1; then
      echo "==> Pulling latest Public Engine ($SECONDBRAIN_HOME)..."
      git -C "$SECONDBRAIN_HOME" pull --ff-only origin main
    fi
    if [[ -d "$SECONDBRAIN_VAULT/.git" ]] && git -C "$SECONDBRAIN_VAULT" remote get-url origin >/dev/null 2>&1; then
      echo "==> Syncing Private Vault ($SECONDBRAIN_VAULT)..."
      git -C "$SECONDBRAIN_VAULT" pull --rebase --autostash origin main
    fi
    echo "==> Running setup.sh to refresh symlinks, index & read-only locks..."
    "$SECONDBRAIN_HOME/setup.sh"
    pkill -f "mcp-server/daemon.py" 2>/dev/null || true
    echo "==> Upgrade complete."
    ;;

  publish)
    MSG="${1:-}"
    chmod -R u+w "$SECONDBRAIN_HOME" 2>/dev/null || true
    trap 'chmod -R a-w "$SECONDBRAIN_HOME/skills" "$SECONDBRAIN_HOME/invariants" "$SECONDBRAIN_HOME/mcp-server" "$SECONDBRAIN_HOME/bin" 2>/dev/null || true' EXIT
    "$SECONDBRAIN_HOME/bin/secondbrain" privacy-check
    git -C "$SECONDBRAIN_HOME" add -A
    if ! git -C "$SECONDBRAIN_HOME" diff --cached --quiet; then
      git -C "$SECONDBRAIN_HOME" commit -m "${MSG:-chore: update secondbrain engine}"
    fi
    "$SECONDBRAIN_HOME/bin/secondbrain" judge-verify
    git -C "$SECONDBRAIN_HOME" push origin main
    echo "==> Published cleanly to Public Engine remote and re-locked read-only permissions."
    ;;

  *)
    echo "Usage: secondbrain {status|ps|prune|report|search|compact|invariants|privacy-check|judge-approve|judge-verify|upgrade|publish}" >&2
    exit 1
    ;;
esac
